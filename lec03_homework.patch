+LEARNING_LOG_DIR = Path(os.getenv("AIE_LEARNING_LOG_DIR", REPO_ROOT / "learning_log"))
+MAX_TITLE_CHARS = 80
+MAX_CONTENT_CHARS = 2000
+MAX_LECTURE = 13  # el curso tiene 13 sesiones; 0 = sin sesión concreta
